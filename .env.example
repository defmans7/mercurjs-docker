# Database Configuration
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=mercur_db
DB_PORT=5432

# Application Port
BACKEND_PORT=9000

# Stripe Configuration
STRIPE_SECRET_API_KEY=sk_test_your_key_here
STRIPE_CONNECTED_ACCOUNTS_WEBHOOK_SECRET=whsec_your_webhook_secret

# Resend Configuration
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Algolia Configuration
ALGOLIA_APP_ID=your_app_id
ALGOLIA_API_KEY=your_api_key

# TalkJS Configuration
VITE_TALK_JS_APP_ID=your_talkjs_app_id
VITE_TALK_JS_SECRET_API_KEY=your_talkjs_secret

# CORS Configuration
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:7001
VENDOR_CORS=http://localhost:7000
AUTH_CORS=http://localhost:9000

# Application URLs
VENDOR_PANEL_URL=http://localhost:7000
STOREFRONT_URL=http://localhost:8000
BACKEND_URL=http://localhost:9000

# Security Secrets (Change these in production!)
JWT_SECRET=your_super_secret_jwt_key_change_this
COOKIE_SECRET=your_super_secret_cookie_key_change_this

